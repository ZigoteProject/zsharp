/// A module's LLVM IR (the F# compiler's Codegen.compile): its functions, top-level values, entry
/// points (main, a test build's, C exports), the C header for the exports, and the word size
/// resolved for the target.
open Types.Ty
open Core.Ir
open Core.Program
open Emit
open Layout
open Helpers
open Debug
open Fun

/// The module text with the word placeholders resolved (i_W, and the header sizes HDR1 = one
/// word, HDR2 = two). String constants (c"...") are left as written.
let resolveWord (opts: Options) (ir: string) : string =
  let (w, h1, h2) = if word32 opts.target then ("i32", "4", "8") else ("i64", "8", "16")
  // -Os: optsize on every function definition. LLVM's unroller and vectorizer go by this
  // attribute (clang adds it to C functions), not by the -Os flag alone
  let sized (line: string) : string =
    if opts.optimizeSize && String.startsWith "define " line && String.endsWith "{" line then
      match String.indexOf " !dbg " line with
      | Some i when i > 0 -> String.sub line 0 i + " optsize" + String.sub line i (String.length line - i)
      | _ -> String.sub line 0 (String.length line - 1) + "optsize {"
    else
      line
  let one (line0: string) : string =
    let line = sized line0
    let (head0, tail) =
      match String.indexOf " c\"" line with
      | Some cut -> (String.sub line 0 cut, String.sub line cut (String.length line - cut))
      | None -> (line, "")
    let head1 = if opts.wideVectors then String.replace head0 "@zs_alloc(" "@zs_alloc_wide(" else head0
    let head2 = if opts.checkedHeap then String.replace (String.replace head1 "@zs_alloc(" "@zs_alloc_checked(") "@zs_free(" "@zs_free_checked(" else head1
    String.replace (String.replace (String.replace head2 "i_W" w) "HDR2" h2) "HDR1" h1 + tail
  if opts.optimizeSize || opts.wideVectors || opts.checkedHeap then
    String.join "\n" (List.map one (String.split "\n" ir))
  else
    // one pass over the text, what's between the placeholders copied whole, and a string
    // constant (c"…" after a space, to its closing quote) left as written: splitting the text
    // into lines and replacing in each was an eighth of a build's instructions
    let b = String.bytes ir
    let n = String.length ir
    let out = StringBuilder.create ()
    let mutable from = 0
    let mutable i = 0
    while i < n do
      let c = b.[i]
      if c = u8 99 && i > 0 && b.[i - 1] = u8 32 && i + 1 < n && b.[i + 1] = u8 34 then
        i <- i + 2
        while i < n && b.[i] <> u8 34 do
          i <- i + 1
        i <- i + 1
      else if c = u8 105 && i + 2 < n && b.[i + 1] = u8 95 && b.[i + 2] = u8 87 then
        StringBuilder.appendSub ir from (i - from) out
        StringBuilder.append w out
        i <- i + 3
        from <- i
      else if c = u8 72 && i + 3 < n && b.[i + 1] = u8 68 && b.[i + 2] = u8 82 && (b.[i + 3] = u8 49 || b.[i + 3] = u8 50) then
        StringBuilder.appendSub ir from (i - from) out
        StringBuilder.append (if b.[i + 3] = u8 49 then h1 else h2) out
        i <- i + 4
        from <- i
      else
        i <- i + 1
    StringBuilder.appendSub ir from (n - from) out
    StringBuilder.toString out

let private isUnitTy (t: Ty) : bool =
  match t with
  | TCon("unit", []) -> true
  | _ -> false

// a function type's parameters and result
let rec private splitFun (t: Ty) : list<Ty> * Ty =
  match t with
  | TFun(a, r, _) ->
    let (ps, res) = splitFun r
    (a :: ps, res)
  | r -> ([], r)

let private headerStart = "// Generated by zs. Do not edit.\n#pragma once\n#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n\n// Runs when the library panics, after the message is printed (to log, flush or save state).\n// The process stops when it returns. It must not call back into the library.\nvoid zs_set_panic_hook(void (*hook)(const char *message));\n\n// A Z# value held by C: an object with its own count. zs_retain adds a reference and\n// zs_release gives one up (the last one frees the object). A handle a function returns is\n// the caller's to release; one passed to a function is only borrowed for the call.\ntypedef struct zs_handle_ *zs_handle;\nvoid zs_retain(zs_handle h);\nvoid zs_release(zs_handle h);\n\n"

let private signedInts : Set<string> = Set.ofList [ "i8"; "i16"; "i32"; "i64" ]

let private unsignedInts : Set<string> = Set.ofList [ "u8"; "u16"; "u32"; "u64" ]

/// Compiles closure-converted, reference-counted functions to textual LLVM IR, with a C header for
/// the exported functions. With a part, only that part's functions are defined; the others it
/// calls are declared, and what must have one address in the program (top-level values, the
/// static cells of cases without fields) is defined in every part for the linker to merge. Error:
/// what the program can't be compiled for (the line of the statement, and a message).
let compile (opts: Options) (types: Map<string, TypeInfo>) (externs: Map<string, ExternSig>) (exports: list<Export>) (tests: list<string>) (values: list<string * string>) (clayouts: Set<string>) (part: option<Part>) (funs: list<MFun>) : result<string * string, int * string> =
  // one address in the whole program
  let shared = if Option.isSome part then "linkonce_odr hidden" else "private"
  let pre0 = if opts.threaded then replaceDef (replaceDef Prelude.prelude Prelude.threadedDup) Prelude.threadedRelease else Prelude.prelude
  let pre = String.replace (String.replace pre0 "@zs.none = private constant" $"@zs.none = {shared} constant") "@zs.noelems = private constant" $"@zs.noelems = {shared} constant"
  let top = Buffer.empty
  Buffer.push pre top
  let fnTable = Map.ofList (List.map (fun (f: MFun) -> (f.name, f)) funs)
  let mainFile =
    match List.tryFind (fun (f: MFun) -> f.name = "main") funs with
    | Some f -> f.file
    | None -> "main.zs"
  let data : GData =
    { types = types
      externs = externs
      opts = opts
      v = Types.Vars.make ()
      part = part
      shared = shared
      top = top
      helpers = Buffer.empty
      funcs = Buffer.empty
      generated = ref Set.empty
      strings = ref Map.empty
      fnTable = fnTable
      referenced = ref Set.empty
      referencedOrder = Buffer.empty
      reps = ref Map.empty
      md = Buffer.empty
      mdCount = ref 0
      diFiles = ref Map.empty
      locs = ref Map.empty
      diTypes = ref Map.empty
      lenRange = ref None
      compileUnit = ref None
      noTypes = ref None
      mainFile = mainFile
      failure = ref None }
  let g = G data
  let defined (f: string) =
    match part with
    | Some p -> Set.contains f p.defines
    | None -> true
  let entry =
    match part with
    | Some p -> p.entry
    | None -> true
  // top-level values computed at startup: a global each. The entry starts every value; another
  // part has the values it reads (each part defines its own, the linker merges them), so its code
  // depends on those only
  let valueTypes =
    if entry then
      Map.ofList (List.map (fun (v, init) -> (v, (Map.find init fnTable).ret)) values)
    else
      let read = ref Map.empty
      let rec walk (e: CExpr) =
        match e.k with
        | CGlobalVal v -> read.Value <- Map.add v e.ty read.Value
        | k -> List.iter walk (children k)
      for f in funs do
        if defined f.name then
          walk f.body
      read.Value
  for (v, _) in values do
    match Map.tryFind v valueTypes with
    | Some t ->
      let linkage = if Option.isSome part then "linkonce_odr hidden" else "internal"
      topLine g $"{valueSym v} = {linkage} global {llty g t} zeroinitializer"
    | None -> ()
  for (name, s) in Map.toList externs do
    let (ret, sret) = cRet g s.ret
    let sretP = if sret then [ $"ptr sret({llty g s.ret})" ] else []
    let ps = List.concat [ sretP; cParamList g s.pars sret; (if s.variadic then [ "..." ] else []) ]
    topLine g $"declare {ret} @{name}({String.join ", " ps})"
  for f in funs do
    if defined f.name then
      genFun g f
  // runs the initializers in order, storing each value (main's prologue); with threads, a value
  // threads can share is marked shared: any of them may read it
  let initValues () : string =
    let one (i: int) (vi: string * string) =
      let (v, init) = vi
      let vt = Map.find v valueTypes
      let t = llty g vt
      let share =
        if opts.threaded && Option.isNone (Types.Repr.shareBlocker g.v (fun _ -> ()) types Set.empty vt) then
          let em = emitter ()
          shareValue g em vt $"%iv{i}"
          codeOf em
        else
          ""
      $"  %iv{i} = call {t} {sym g init}()\n{share}  store {t} %iv{i}, ptr {valueSym v}\n"
    String.concat (List.mapi one values)
  // the values, released in reverse order after main returns (so the leak check stays exact)
  if entry then
    let em = emitter ()
    for (v, _) in List.rev values do
      let t = Map.find v valueTypes
      if heap g t then
        dropValue g em t (instr em $"load {llty g t}, ptr {valueSym v}")
    emit em "ret void"
    Buffer.push $"define private void @zsv.dropAll() {{\n{bodyOf em}}}\n\n" g.funcs
  // C entry points: main (an int result becomes the exit code) and [<Export>] wrappers
  if entry && Map.containsKey "main" fnTable then
    let main = Map.find "main" fnTable
    let rt = llty g main.ret
    let body =
      if tyName main.ret = "unit" then
        $"  call {{}} {sym g "main"}({{}} zeroinitializer)\n  ret i32 0"
      else if rt = "i32" then
        $"  %r = call i32 {sym g "main"}({{}} zeroinitializer)\n  ret i32 %r"
      else
        $"  %r = call {rt} {sym g "main"}({{}} zeroinitializer)\n  %c = trunc {rt} %r to i32\n  ret i32 %c"
    Buffer.push "define i32 @main(i32 %argc, ptr %argv) {\n  call void @zs_set_args(i32 %argc, ptr %argv)\n" g.funcs
    Buffer.push (initValues ()) g.funcs
    Buffer.push (String.replace body "  ret i32" "  call void @zsv.dropAll()\n  ret i32" + "\n}\n") g.funcs
  // a test build (zs test): main is the file's test entry ($tests, 0009), which lists the tests
  // or runs the one its argument names, so each test runs in its own process
  if entry && not (List.isEmpty tests) && not (Map.containsKey "main" fnTable) then
    let first = List.head tests
    let rt = llty g (Map.find first fnTable).ret
    Buffer.push "define i32 @main(i32 %argc, ptr %argv) {\n  call void @zs_set_args(i32 %argc, ptr %argv)\n" g.funcs
    Buffer.push (initValues ()) g.funcs
    Buffer.push $"  %r = call {rt} {sym g first}({{}} zeroinitializer)\n" g.funcs
    Buffer.push $"  %c = trunc {rt} %r to i32\n  call void @zsv.dropAll()\n  ret i32 %c\n}}\n" g.funcs
  for e in (if entry then exports else []) do
    let fd = Map.find e.fname fnTable
    let em = emitter ()
    let (rt, sret) = cRet g e.ret
    let cps = Buffer.empty
    if sret then
      // aligned as the struct is, as C's caller aligns it (8 would let LLVM store a word pair
      // where a Cortex-M faults)
      let (_, align, _) = cLayout g e.ret
      Buffer.push $"ptr sret({llty g e.ret}) align {align} %ret" cps
    let modes = cModes g (List.map snd fd.pars) sret
    let argOf (i: int) (pt: string * Ty) : Ty * string =
      let t = snd pt
      let n = $"%a{i}"
      match t with
      | TCon("unit", []) -> (t, "zeroinitializer")
      | _ when isHandle g t ->
        // C lends the handle: the object, with a reference of its own for the function
        Buffer.push $"ptr {n}" cps
        (t, instr em $"call ptr @zs_handle_get(ptr {n})")
      | _ ->
        match List.item i modes with
        | Scalar ->
          Buffer.push $"{cParam g t} {n}" cps
          (t, n)
        | Pieces ps ->
          let piece (k: int) (p: string) =
            let nk = $"{n}.{k}"
            Buffer.push (p + " " + nk) cps
            (p, nk)
          let named = List.mapi piece ps
          (t, fromPieces g em t named)
        | Memory ->
          Buffer.push $"{byval g t} {n}" cps
          (t, instr em $"load {llty g t}, ptr {n}")
    let args = List.mapi argOf fd.pars
    let argv = String.join ", " (List.map (fun (t, x) -> llty g t + " " + x) args)
    let r = instr em $"call {llty g fd.ret} {sym g e.fname}({argv})"
    match (e.ret, abiFor g e.ret true) with
    | (TCon("unit", []), _) -> emit em "ret void"
    | _ when isHandle g e.ret ->
      // the result's reference goes to a new handle, the caller's to release
      emit em $"ret ptr {handleOf g em e.ret r}"
    | (_, Memory) ->
      emit em $"store {llty g e.ret} {r}, ptr %ret"
      emit em "ret void"
    | (_, Scalar) -> emit em $"ret {llty g e.ret} {r}"
    | (_, Pieces [ p ]) ->
      let pieces = toPieces g em e.ret r [ p ]
      emit em $"ret {p} {snd (List.head pieces)}"
    | (_, Pieces ps) ->
      let insert (acc: string) (kpv: int * (string * string)) =
        let (k, (p, x)) = kpv
        instr em $"insertvalue {rt} {acc}, {p} {x}, {k}"
      let agg = List.fold insert "poison" (List.indexed (toPieces g em e.ret r ps))
      emit em $"ret {rt} {agg}"
    let cparams = String.join ", " (Array.toList (Buffer.toArray cps))
    Buffer.push $"define {rt} @{e.cname}({cparams}) {{\n{bodyOf em}}}\n\n" g.funcs
  // the header: [<CLayout>] structs, then prototypes
  let rec cName (t: Ty) : string =
    match t with
    | _ when isHandle g t -> "zs_handle"
    | TCon("ptr", [ p ]) -> (if isUnitTy p then "void" else cName p) + "*"
    | TCon("cptr", []) -> "void*"
    | TCon("fnptr", [ f ]) -> cFnPtr f ""
    | TCon("int", []) -> "intptr_t"
    | TCon(n, []) when Set.contains n signedInts -> $"int{String.sub n 1 (String.length n - 1)}_t"
    | TCon(n, []) when Set.contains n unsignedInts -> $"uint{String.sub n 1 (String.length n - 1)}_t"
    | TCon("usize", []) -> "size_t"
    | TCon("f64", []) -> "double"
    | TCon("f32", []) -> "float"
    | TCon("bool", []) -> "bool"
    | TCon("cstr", []) -> "const char*"
    | TCon("unit", []) -> "void"
    | TCon(n, []) -> String.replace n "." "_"
    | _ -> panic $"no C name for {showT g t}"
  // a C function pointer's declarator: R (*name)(A, B)
  and cFnPtr (f: Ty) (name: string) : string =
    let (ps0, r) = splitFun f
    let ps = List.map cName (List.filter (fun p -> not (isUnitTy p)) ps0)
    $"{cName r} (*{name})({(if List.isEmpty ps then "void" else String.join ", " ps)})"
  // a C declaration of `name` with this type (a function pointer's name goes inside it, and an
  // array's length after it: uint8_t data[16])
  let rec cDecl (t: Ty) (name: string) : string =
    match t with
    | TCon("fnptr", [ f ]) -> cFnPtr f name
    | TCon("fixed", [ el; TCon(n, []) ]) -> cDecl el $"{name}[{n}]"
    | _ -> $"{cName t} {name}"
  let header = Buffer.empty
  Buffer.push headerStart header
  // each struct after the ones its fields hold, so C knows them where it's used (by name
  // otherwise)
  let written = ref Set.empty
  let rec writeStruct (n: string) =
    if Set.contains n clayouts && not (Set.contains n written.Value) then
      written.Value <- Set.add n written.Value
      let shape =
        match Map.tryFind n types with
        | Some { def = RecordDef fs } -> Some("struct", fs)
        | Some { def = CUnionDef cs } -> Some("union", List.map (fun (c, ft) -> (Infer.Cx.afterLastDot c, ft)) cs)
        | _ -> None
      match shape with
      | Some(kind, fs) ->
        let rec held (t: Ty) =
          match t with
          | TCon(m, args) ->
            writeStruct m
            List.iter held args
          | TTuple ts -> List.iter held ts
          | _ -> ()
        for (_, ft) in fs do
          held ft
        let name = String.replace n "." "_"
        let fields = String.join "\n" (List.map (fun (f, ft) -> $"    {cDecl ft f};") fs)
        // the C compiler on the other side checks the size Z# lays the struct out with (0004)
        let check =
          match Types.Repr.layout g.v types (pointerBytes g) (TCon(n, [])) with
          | Some(size, _) -> $"_Static_assert(sizeof({name}) == {size}, \"{name} is {size} bytes in Z#\");\n"
          | None -> ""
        Buffer.push $"typedef {kind} {name} {{\n{fields}\n}} {name};\n{check}\n" header
      | None -> ()
  for n in Set.toList clayouts do
    writeStruct n
  for e in exports do
    let ps = List.mapi (fun i t -> cDecl t $"p{i}") e.pars
    Buffer.push $"{cName e.ret} {e.cname}({(if List.isEmpty ps then "void" else String.join ", " ps)});\n" header
  if opts.debugInfo then
    let cu = compileUnit g
    let flags = meta g "!{i32 7, !\"Dwarf Version\", i32 5}"
    let version = meta g "!{i32 2, !\"Debug Info Version\", i32 3}"
    Buffer.push $"!llvm.dbg.cu = !{{{cu}}}\n" g.md
    Buffer.push $"!llvm.module.flags = !{{{flags}, {version}}}\n" g.md
  // the functions of other parts this one calls
  for f in Array.toList (Buffer.toArray g.referencedOrder) do
    if not (defined f) then
      match Map.tryFind f fnTable with
      | Some fd ->
        let ps = String.join ", " (List.map (fun (_, t) -> llty g t) fd.pars)
        Buffer.push $"declare {llty g fd.ret} {sym g f}({ps})\n" g.funcs
      | None -> ()
  match g.failure.Value with
  | Some(line, msg) -> Error(line, msg)
  | None ->
    let ir = String.concat [ joined top; "\n"; joined g.helpers; joined g.funcs; "\n"; joined g.md ]
    Ok(resolveWord opts ir, joined header)
