/// A module's LLVM IR (the F# compiler's Codegen.compile): its functions, top-level values, entry
/// points (main, a test build's, C exports), the C header for the exports, and the word size
/// resolved for the target.
open Types.Ty
open Core.Ir
open Core.Program
open Emit
open Layout
open Helpers
open Debug
open Fun

/// The module text with the word placeholders resolved (i_W, and the header sizes HDR1 = one
/// word, HDR2 = two). String constants (c"...") are left as written.
let resolveWord (opts: Options) (ir: string) : string =
  let (w, h1, h2) = if word32 opts.target then ("i32", "4", "8") else ("i64", "8", "16")
  // -Os: optsize on every function definition. LLVM's unroller and vectorizer go by this
  // attribute (clang adds it to C functions), not by the -Os flag alone
  let sized (line: string) : string =
    if opts.optimizeSize && String.startsWith "define " line && String.endsWith "{" line then
      match String.indexOf " !dbg " line with
      | Some i when i > 0 -> String.sub line 0 i + " optsize" + String.sub line i (String.length line - i)
      | _ -> String.sub line 0 (String.length line - 1) + "optsize {"
    else
      line
  let one (line0: string) : string =
    let line = sized line0
    let (head0, tail) =
      match String.indexOf " c\"" line with
      | Some cut -> (String.sub line 0 cut, String.sub line cut (String.length line - cut))
      | None -> (line, "")
    let head1 = if opts.wideVectors then String.replace head0 "@zs_alloc(" "@zs_alloc_wide(" else head0
    let head2 = if opts.checkedHeap then String.replace (String.replace head1 "@zs_alloc(" "@zs_alloc_checked(") "@zs_free(" "@zs_free_checked(" else head1
    String.replace (String.replace (String.replace head2 "i_W" w) "HDR2" h2) "HDR1" h1 + tail
  if opts.optimizeSize || opts.wideVectors || opts.checkedHeap then
    String.join "\n" (List.map one (String.split "\n" ir))
  else
    // one pass over the text, what's between the placeholders copied whole, and a string
    // constant (c"…" after a space, to its closing quote) left as written: splitting the text
    // into lines and replacing in each was an eighth of a build's instructions
    let b = String.bytes ir
    let n = String.length ir
    let out = StringBuilder.create ()
    let mutable from = 0
    let mutable i = 0
    while i < n do
      let c = b.[i]
      if c = u8 99 && i > 0 && b.[i - 1] = u8 32 && i + 1 < n && b.[i + 1] = u8 34 then
        i <- i + 2
        while i < n && b.[i] <> u8 34 do
          i <- i + 1
        i <- i + 1
      else if c = u8 105 && i + 2 < n && b.[i + 1] = u8 95 && b.[i + 2] = u8 87 then
        StringBuilder.appendSub ir from (i - from) out
        StringBuilder.append w out
        i <- i + 3
        from <- i
      else if c = u8 72 && i + 3 < n && b.[i + 1] = u8 68 && b.[i + 2] = u8 82 && (b.[i + 3] = u8 49 || b.[i + 3] = u8 50) then
        StringBuilder.appendSub ir from (i - from) out
        StringBuilder.append (if b.[i + 3] = u8 49 then h1 else h2) out
        i <- i + 4
        from <- i
      else
        i <- i + 1
    StringBuilder.appendSub ir from (n - from) out
    StringBuilder.toString out

let private isUnitTy (t: Ty) : bool =
  match t with
  | TCon("unit", []) -> true
  | _ -> false

// a function type's parameters and result
let rec private splitFun (t: Ty) : list<Ty> * Ty =
  match t with
  | TFun(a, r, _) ->
    let (ps, res) = splitFun r
    (a :: ps, res)
  | r -> ([], r)

let private headerStart = "// Generated by zs. Do not edit.\n#pragma once\n#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n\n// Runs when the library panics, after the message is printed (to log, flush or save state).\n// The process stops when it returns. It must not call back into the library.\nvoid zs_set_panic_hook(void (*hook)(const char *message));\n\n// A Z# value held by C: an object with its own count. zs_retain adds a reference and\n// zs_release gives one up (the last one frees the object). A handle a function returns is\n// the caller's to release; one passed to a function is only borrowed for the call.\ntypedef struct zs_handle_ *zs_handle;\nvoid zs_retain(zs_handle h);\nvoid zs_release(zs_handle h);\n\n"

let private signedInts : Set<string> = Set.ofList [ "i8"; "i16"; "i32"; "i64" ]

let private unsignedInts : Set<string> = Set.ofList [ "u8"; "u16"; "u32"; "u64" ]

/// Compiles closure-converted, reference-counted functions to textual LLVM IR, with a C header for
/// the exported functions. With a part, only that part's functions are defined; the others it
/// calls are declared, and what must have one address in the program (top-level values, the
/// static cells of cases without fields) is defined in every part for the linker to merge. Error:
/// what the program can't be compiled for (the line of the statement, and a message).
let compile (opts: Options) (types: Map<string, TypeInfo>) (externs: Map<string, ExternSig>) (exports: list<Export>) (tests: list<string>) (values: list<string * string>) (clayouts: Set<string>) (placements: Map<string, string * int>) (part: option<Part>) (funs: list<MFun>) : result<string * string, int * string> =
  // one address in the whole program
  let shared = if Option.isSome part then "linkonce_odr hidden" else "private"
  let pre0 = if opts.threaded then replaceDef (replaceDef Prelude.prelude Prelude.threadedDup) Prelude.threadedRelease else Prelude.prelude
  let pre = String.replace (String.replace pre0 "@zs.none = private constant" $"@zs.none = {shared} constant") "@zs.noelems = private constant" $"@zs.noelems = {shared} constant"
  let top = Buffer.empty
  Buffer.push pre top
  let fnTable = Map.ofList (List.map (fun (f: MFun) -> (f.name, f)) funs)
  let mainFile =
    match List.tryFind (fun (f: MFun) -> f.name = "main") funs with
    | Some f -> f.file
    | None -> "main.zs"
  let data : GData =
    { types = types
      externs = externs
      opts = opts
      v = Types.Vars.make ()
      part = part
      shared = shared
      top = top
      helpers = Buffer.empty
      funcs = Buffer.empty
      generated = ref Set.empty
      strings = ref Map.empty
      fnTable = fnTable
      referenced = ref Set.empty
      referencedOrder = Buffer.empty
      reps = ref Map.empty
      lltys = ref Map.empty
      unions = ref Map.empty
      md = Buffer.empty
      mdCount = ref 0
      diFiles = ref Map.empty
      locs = ref Map.empty
      diTypes = ref Map.empty
      cov = ref Map.empty
      covLines = Buffer.empty
      lenRange = ref None
      compileUnit = ref None
      noTypes = ref None
      mainFile = mainFile
      failure = ref None }
  let g = G data
  let defined (f: string) =
    match part with
    | Some p -> Set.contains f p.defines
    | None -> true
  let entry =
    match part with
    | Some p -> p.entry
    | None -> true
  // top-level values computed at startup: a global each. The entry starts every value; another
  // part has the values it reads (each part defines its own, the linker merges them), so its code
  // depends on those only
  let valueTypes =
    if entry then
      Map.ofList (List.map (fun (v, init) -> (v, (Map.find init fnTable).ret)) values)
    else
      let read = ref Map.empty
      let rec walk (e: CExpr) =
        match e.k with
        | CGlobalVal v -> read.Value <- Map.add v e.ty read.Value
        | k -> List.iter walk (children k)
      for f in funs do
        if defined f.name then
          walk f.body
      read.Value
  // a value whose initializer is an array literal of constants (0014 item 1): a static object in
  // the image, count 0 (never unique, so a write copies it; dup and drop leave it alone), the
  // value's global pointing at it and no startup code. Its strings are statics of their own with
  // the same linkage, named by their content, so every part writes the same bytes.
  let sharedStrings = ref Map.empty
  let sharedStr (s: string) : string =
    match Map.tryFind s sharedStrings.Value with
    | Some name -> name
    | None ->
      let n = String.length s
      let name = $"@\"zsstr.{Xxhash.hex (String.bytes s)}\""
      topLine g $"{name} = {shared} unnamed_addr constant {{ i_W, i_W, [{n + 1} x i8] }} {{ i_W 0, i_W {n}, [{n + 1} x i8] c\"{encoded s}\\00\" }}"
      sharedStrings.Value <- Map.add s name sharedStrings.Value
      name
  // a value's [<Section>] and [<Align>] (0014 item 12) as the global's attributes; the section's
  // name is dropped where names are the linker's (macOS, Windows), the storage static all the same
  let placement (v: string) : string * int =
    match Map.tryFind v placements with
    | Some(sec, al) -> ((if isWindows g || String.contains "-apple" g.opts.target then "" else sec), al)
    | None -> ("", 0)
  let placed (v: string) : string =
    let (sec, al) = placement v
    (if sec = "" then "" else $", section \"{sec}\"") + (if al = 0 then "" else $", align {al}")
  // the bytes before an object's two header words that put its data at a multiple of the
  // alignment (the object itself is aligned so)
  let padBefore (v: string) : int =
    let (_, al) = placement v
    if al > 2 * pointerBytes g then al - 2 * pointerBytes g else 0
  // on a bare-metal chip, a placed ref's or Buffer's storage in a section the reset handler
  // doesn't load (one the board's script doesn't name: a DMA region, a second SRAM) is copied
  // from a flash image at startup: (destination, LLVM type, its image's name)
  let bareMetal = String.contains "-none" opts.target
  let startupCopies = ref Map.empty
  // a section a chip's reset neither loads, zeroes nor keeps in flash (one the board's script
  // doesn't name): a writable one is RAM, its contents never loaded from the image
  let unloaded (sec: string) = bareMetal && sec <> "" && not (dataSection sec) && not (noinitSection sec) && not (flashSection sec) && not (bssSection sec)
  // whether a placed ref or Buffer is in the section (which makes it writable, so RAM; alone, a
  // constant's section is read-only, and the linker keeps it in flash)
  let holdsWritable (sec: string) =
    let writableValue (w: string) =
      match Map.tryFind w valueTypes with
      | Some(TCon("ref", _)) -> true
      | _ -> false
    List.exists (fun (w, (s, _)) -> s = sec && writableValue w) (Map.toList placements)
  let copiedAtStartup (v: string) = unloaded (fst (placement v))
  // a placed Buffer's room (its static storage's slots), for the drops at exit
  let placedRooms = ref Map.empty
  let placementFails (message: string) =
    if Option.isNone g.failure.Value then
      g.failure.Value <- Some(0, message)
  // a ref or Buffer in flash would be written there, which faults; one in .bss starts as the
  // zeros a reset leaves there, so only a zero value can
  let rec zeroElem (x: StaticElem) : bool =
    match x with
    | SInt n -> n = i64 0
    | SFloat f -> f = 0.0 && 1.0 / f > 0.0
    | SBool b -> not b
    | SStruct(_, xs) -> List.forall zeroElem xs
    | _ -> false
  let writable (v: string) (x: StaticElem) =
    let (sec, _) = placement v
    if bareMetal && flashSection sec then
      placementFails $"[<Section \"{sec}\">] '{v}': on a chip that section is flash, which a ref or Buffer can't be written in; use .data, .noinit or a RAM section the board's script names"
      false
    else if bareMetal && bssSection sec && not (zeroElem x) then
      placementFails $"[<Section \"{sec}\">] '{v}': a chip's reset zeroes .bss, so what's there starts as zeros; give it a zero value, or use .data for one that starts otherwise"
      false
    else
      true
  let unplaceable (v: string) =
    if Option.isNone g.failure.Value then
      g.failure.Value <- Some(0, $"[<Section>] or [<Align>] value '{v}': its element can't be laid out in the image (a [<Bits>] record or a C union); build it in main instead")
  let staticOf (v: string) (init: string) : option<string> =
    match Map.tryFind init fnTable with
    | Some f when List.isEmpty f.pars ->
      let elemOf (el: Ty) : StaticElem -> string =
        let lt = llty g el
        // an integer in its width's two's complement, as LLVM reads a constant of the type
        let width = if lt = "i8" then 8 else if lt = "i16" then 16 else if lt = "i32" then 32 else 64
        let fitted (n: i64) : i64 =
          if width = 64 then
            n
          else
            let v = n &&& ((i64 1 <<< i64 width) - i64 1)
            if v >= (i64 1 <<< i64 (width - 1)) then v - (i64 1 <<< i64 width) else v
        // the constant's text without its type
        fun (x: StaticElem) ->
          match x with
          | SInt n -> $"{fitted n}"
          | SFloat x -> floatConst lt x
          | SBool b -> if b then "true" else "false"
          | SStr s -> sharedStr s
          | _ -> panic "a static element"
      let isPlaced = Map.containsKey v placements
      // the objects a placed ref's or Buffer's element needs are constants anywhere (in flash on a
      // chip), not in its section, which may be one a reset doesn't load
      let nestedPlaced = ref true
      let nestedPlace () = if nestedPlaced.Value then placed v else ""
      // a static object's name: the value's for the first, then numbered
      let made = ref 0
      let objectName () =
        let name = if made.Value = 0 then $"@\"zss.{v}\"" else $"@\"zss.{v}.{made.Value}\""
        made.Value <- made.Value + 1
        name
      let fieldTypes (t: Ty) : list<Ty> =
        match t with
        | TTuple ts -> ts
        | TCon(n, args) ->
          match (Map.find n g.types).def with
          | RecordDef fs -> List.map (fun (_, ft) -> substGen g args ft) fs
          | _ -> []
        | _ -> []
      // whether the constant can be in the image as the type lays it out: not a [<Bits>] record
      // (built from its fields' bits) or a C union
      let rec feasible (t: Ty) (x: StaticElem) : bool =
        match x with
        | SArray(el, xs) -> List.forall (feasible el) xs
        | SList(lt, xs) ->
          match lt with
          | TCon("list", [ el ]) -> List.forall (feasible el) xs
          | _ -> false
        | SStruct(st, xs) ->
          Option.isNone (bitsLayoutOf g st) && Option.isNone (cUnion g st) && List.length (fieldTypes st) = List.length xs && List.forall (fun (ft, y) -> feasible ft y) (List.zip (fieldTypes st) xs)
        | SCtor(ut, tag, xs) ->
          match ut with
          | TCon(n, _) when isUnionType g n && Option.isNone (cUnion g ut) ->
            let fs = snd (List.item tag (snd (union g ut)))
            List.length fs = List.length xs && List.forall (fun (ft, y) -> feasible ft y) (List.zip fs xs)
          | _ -> false
        | _ -> true
      // the constant of type t, as an initializer's text without its type; the objects it needs
      // (arrays, list cells, boxed cases) emitted, each with the value's section and alignment
      let rec constOf (t: Ty) (x: StaticElem) : string =
        let typed (ft: Ty) (y: StaticElem) = $"{llty g ft} {constOf ft y}"
        match x with
        | SArray(el, xs) ->
          if List.isEmpty xs then
            "@zs.noelems"
          else
            let lt = llty g el
            let n = List.length xs
            let name = objectName ()
            let pad = if name = $"@\"zss.{v}\"" then padBefore v else 0
            let elems = String.join ", " (List.map (typed el) xs)
            if pad = 0 then
              topLine g $"{name} = {shared} unnamed_addr constant {{ i_W, i_W, [{n} x {lt}] }} {{ i_W 0, i_W {n}, [{n} x {lt}] [{elems}] }}{nestedPlace ()}"
              name
            else
              // the bytes before the header put the data at a multiple of the alignment
              topLine g $"{name} = {shared} unnamed_addr constant {{ [{pad} x i8], i_W, i_W, [{n} x {lt}] }} {{ [{pad} x i8] zeroinitializer, i_W 0, i_W {n}, [{n} x {lt}] [{elems}] }}{nestedPlace ()}"
              $"getelementptr (i8, ptr {name}, i_W {pad})"
        | SList(lt, xs) ->
          // a cell per element, each pointing at the next, the last at the static []; the header
          // as a cons cell's: the count 0, and the tag where the union keeps one
          let el =
            match lt with
            | TCon("list", [ el ]) -> el
            | _ -> panic "a static list's type"
          let nil = nullary g lt 0
          if List.isEmpty xs then
            nil
          else
            let cell = cellTy g lt 1
            let header = if tagged g lt && not (tagWord g lt) then $"{i64 1 <<< i64 32}" else "0"
            let tagPart = if tagWord g lt then ", i32 1" else ""
            let names = List.map (fun _ -> objectName ()) xs
            let n = List.length xs
            List.iteri (fun (i: int) (y: StaticElem) ->
              let next = if i + 1 < n then List.item (i + 1) names else nil
              topLine g $"{List.item i names} = {shared} unnamed_addr constant {cell} {{ i_W {header}{tagPart}, {typed el y}, ptr {next} }}{nestedPlace ()}") xs
            List.head names
        | SStruct(st, xs) -> "{ " + String.join ", " (List.map2 typed (fieldTypes st) xs) + " }"
        | SCtor(ut, tag, xs) ->
          let cases = snd (union g ut)
          let fs = snd (List.item tag cases)
          if Types.Repr.plainUnion g.v g.types ut then
            // the tag (none for one case), this case's fields, the other cases' zero
            match (oneCase g ut, xs) with
            | (Some [ _ ], [ y ]) -> constOf (List.head fs) y
            | (one, _) ->
              let tagPart = if Option.isSome one then [] else [ $"{tagTy cases} {tag}" ]
              let ofCase (ci: int) (c: string * list<Ty>) =
                if ci = tag then List.map2 typed (snd c) xs else List.map (fun ft -> $"{llty g ft} zeroinitializer") (snd c)
              "{ " + String.join ", " (List.append tagPart (List.concat (List.mapi ofCase cases))) + " }"
          else if isNiche g ut then
            // the payload itself, or the static None
            match xs with
            | [ y ] -> constOf (List.head fs) y
            | _ -> "@zs.none"
          else if List.isEmpty xs then
            nullary g ut tag
          else
            // a boxed case: a static cell, the tag in its header where the union keeps one
            let cell = cellTy g ut tag
            let header = if tagged g ut && not (tagWord g ut) then $"{i64 tag <<< i64 32}" else "0"
            let tagPart = if tagWord g ut then $", i32 {tag}" else ""
            let name = objectName ()
            topLine g $"{name} = {shared} unnamed_addr constant {cell} {{ i_W {header}{tagPart}, {String.join ", " (List.map2 typed fs xs)} }}{nestedPlace ()}"
            name
        | _ -> elemOf t x
      match f.ret with
      // a Buffer is a ref to its storage cell from monomorphization on
      | TCon("ref", [ TCon("$buffer", [ el ]) ]) when isPlaced ->
        // a Buffer over static storage: its elements in the section, aligned (plain bytes, so a
        // .noinit one has no header to lose), its owner an empty static array it never windows
        // from the start of (so growing copies into the heap and leaves the storage), and its
        // cell static too
        match placedInit f.body with
        | Some(PlacedBuffer(n, x)) when feasible el x && writable v x ->
          placedRooms.Value <- Map.add v n placedRooms.Value
          let lt = llty g el
          let data = $"@\"zss.{v}.data\""
          let owner = $"@\"zss.{v}.owner\""
          let name = $"@\"zss.{v}\""
          // the element once (its objects, if any, named after the cell's: zss.v.1, …)
          made.Value <- 1
          nestedPlaced.Value <- false
          let et = constOf el x
          nestedPlaced.Value <- true
          let elems = if n = 0 then "zeroinitializer" else $"[{String.join ", " (List.replicate n $"{lt} {et}")}]"
          topLine g $"{data} = {shared} global [{n} x {lt}] {elems}{placed v}"
          if copiedAtStartup v then
            let image = $"@\"zss.{v}.data.image\""
            topLine g $"{image} = {shared} unnamed_addr constant [{n} x {lt}] {elems}"
            startupCopies.Value <- Map.add v (data, $"[{n} x {lt}]", image) startupCopies.Value
          topLine g $"{owner} = {shared} global {{ i_W, i_W, [0 x {lt}] }} {{ i_W 0, i_W 0, [0 x {lt}] zeroinitializer }}"
          topLine g $"{name} = {shared} global {{ i_W, {{ ptr, ptr, i_W, i_W }} }} {{ i_W 0, {{ ptr, ptr, i_W, i_W }} {{ ptr {owner}, ptr {data}, i_W {n}, i_W {n} }} }}"
          Some name
        | Some(PlacedBuffer _) ->
          unplaceable v
          None
        | _ -> None
      | TCon("ref", [ t ]) when isPlaced ->
        // a ref cell with the constant in it; in .noinit its header is written at startup (the
        // count 0 of a static), the value left as the memory holds it
        match placedInit f.body with
        | Some(PlacedRef x) when feasible t x && writable v x ->
          let name = $"@\"zss.{v}\""
          made.Value <- 1
          nestedPlaced.Value <- false
          let init = $"{{ i_W 0, {llty g t} {constOf t x} }}"
          nestedPlaced.Value <- true
          topLine g $"{name} = {shared} global {{ i_W, {llty g t} }} {init}{placed v}"
          if copiedAtStartup v then
            let image = $"@\"zss.{v}.image\""
            topLine g $"{image} = {shared} unnamed_addr constant {{ i_W, {llty g t} }} {init}"
            startupCopies.Value <- Map.add v (name, $"{{ i_W, {llty g t} }}", image) startupCopies.Value
          Some name
        | Some(PlacedRef _) ->
          unplaceable v
          None
        | _ -> None
      | t ->
        // a constant: tables, lists and boxed cases as static objects, a record, tuple or plain
        // union written into the value's global, a number or string the same (0014 items 1, 3)
        match staticElem f.body with
        | Some _ when isPlaced && unloaded (fst (placement v)) && holdsWritable (fst (placement v)) ->
          let (sec, _) = placement v
          placementFails $"[<Section \"{sec}\">] constant '{v}': on a chip, a section the board's linker script doesn't name that holds a ref or Buffer too is RAM, never loaded from the flash image, so the table would be lost; give the constant a section of its own (read-only, kept in flash), or drop the attribute"
          None
        | Some _ when isPlaced && bareMetal && bssSection (fst (placement v)) ->
          let (sec, _) = placement v
          placementFails $"[<Section \"{sec}\">] constant '{v}': a chip's reset zeroes .bss, so the table would be lost; drop the attribute (a constant is in flash already), or use .data for a RAM copy"
          None
        | Some x when feasible t x -> Some(constOf t x)
        | _ -> None
    | _ -> None
  let statics = Map.ofList (List.choose (fun (v, init) -> if Map.containsKey v valueTypes then Option.map (fun s -> (v, s)) (staticOf v init) else None) values)
  // a library has no main to run the others' initializers, nor the startup work of a placed
  // value: a copy from flash, a .noinit ref's header
  if opts.library then
    match List.tryFind (fun (v, _) -> Map.containsKey v valueTypes && not (Map.containsKey v statics) && not (String.contains "$assert" v)) values with
    | Some(v, _) when Option.isNone g.failure.Value ->
      g.failure.Value <- Some(0, $"top-level value '{v}' is computed at startup, which a library doesn't have; make it a constant (a literal table, record or union of constants is one) or a function")
    | _ -> ()
    let startupWork (v: string) =
      let (sec, _) = placement v
      let noinitRef =
        match Map.tryFind v valueTypes with
        | Some(TCon("ref", [ TCon("$buffer", _) ])) -> false
        | Some(TCon("ref", [ _ ])) -> bareMetal && noinitSection sec
        | _ -> false
      Map.containsKey v statics && (Map.containsKey v startupCopies.Value || noinitRef)
    match List.tryFind (fun (v, _) -> startupWork v) values with
    | Some(v, _) ->
      let (sec, _) = placement v
      placementFails $"[<Section \"{sec}\">] '{v}' needs startup work in a library, which has none (a copy from flash into a section the reset doesn't load, or a .noinit ref's header written); keep that storage in the firmware and pass it in, or use a Buffer.create in .noinit"
    | None -> ()
  for (v, _) in values do
    match Map.tryFind v valueTypes with
    | Some t ->
      let linkage = if Option.isSome part then "linkonce_odr hidden" else "internal"
      let initial =
        match Map.tryFind v statics with
        | Some s -> s
        | None -> "zeroinitializer"
      topLine g $"{valueSym v} = {linkage} global {llty g t} {initial}"
    | None -> ()
  for (name, s) in Map.toList externs do
    let (ret, sret) = cRet g s.ret
    let sretP = if sret then [ $"ptr sret({llty g s.ret})" ] else []
    let ps = List.concat [ sretP; cParamList g s.pars sret; (if s.variadic then [ "..." ] else []) ]
    topLine g $"declare {ret} @{name}({String.join ", " ps})"
  for f in funs do
    if defined f.name then
      genFun g f
  // runs the initializers in order, storing each value (main's prologue); with threads, a value
  // threads can share is marked shared: any of them may read it
  let initValues () : string =
    let one (i: int) (vi: string * string) =
      let (v, init) = vi
      if Map.containsKey v statics then
        let (sec, _) = placement v
        match Map.tryFind v startupCopies.Value with
        // a section the reset doesn't load: the storage copied from its flash image
        | Some(dst, ty, image) -> $"  call void @llvm.memcpy.p0.p0.i_W(ptr {dst}, ptr {image}, i_W ptrtoint (ptr getelementptr ({ty}, ptr null, i32 1) to i_W), i1 false)\n"
        | None ->
          // a .noinit ref's header on a chip: the memory is whatever it was, the count must be a
          // static's (elsewhere the section is loaded from the image like any other)
          match Map.find v valueTypes with
          | TCon("ref", [ TCon("$buffer", _) ]) -> ""
          | TCon("ref", [ _ ]) when bareMetal && noinitSection sec -> $"  store i_W 0, ptr @\"zss.{v}\"\n"
          | _ -> ""
      else
        let vt = Map.find v valueTypes
        let t = llty g vt
        let share =
          if opts.threaded && Option.isNone (Types.Repr.shareBlocker g.v (fun _ -> ()) types Set.empty vt) then
            let em = emitter ()
            shareValue g em vt $"%iv{i}"
            codeOf em
          else
            ""
        $"  %iv{i} = call {t} {sym g init}()\n{share}  store {t} %iv{i}, ptr {valueSym v}\n"
    String.concat (List.mapi one values)
  // the values, released in reverse order after main returns (so the leak check stays exact)
  if entry then
    let em = emitter ()
    for (v, _) in List.rev values do
      let t = Map.find v valueTypes
      match t with
      | TCon("ref", [ b ]) when isBuf t && Map.containsKey v statics ->
        // a placed Buffer: its cell is static, but a push past its room moved its contents to
        // the heap, and those go as a Buffer's do (its owner released); its static storage's
        // elements are dropped one by one
        let el =
          match b with
          | TCon("$buffer", [ el ]) -> el
          | _ -> b
        let cell = instr em $"load ptr, ptr {valueSym v}"
        let sp = instr em $"getelementptr {{ i_W, {llty g b} }}, ptr {cell}, i32 0, i32 1"
        if heap g el then
          // every slot of the static storage holds one reference until exit, whatever the
          // Buffer did since: a write drops the old one, a push past the room copies (dups) the
          // contents to the heap, and removeLast and truncate leave the slots as they are
          let room = Option.defaultValue 0 (Map.tryFind v placedRooms.Value)
          let data = $"@\"zss.{v}.data\""
          let l = fresh em "pdrop"
          let slot = "%" + fresh em "pi"
          alloca em $"{slot} = alloca i_W"
          emit em $"store i_W 0, ptr {slot}"
          emit em $"br label %{l}.cond"
          enter em (l + ".cond")
          let i = instr em $"load i_W, ptr {slot}"
          let more = instr em $"icmp slt i_W {i}, {room}"
          emit em $"br i1 {more}, label %{l}.body, label %{l}.end"
          enter em (l + ".body")
          let ep = instr em $"getelementptr {llty g el}, ptr {data}, i_W {i}"
          dropValue g em el (instr em $"load {llty g el}, ptr {ep}")
          emit em $"store i_W {instr em $"add i_W {i}, 1"}, ptr {slot}"
          emit em $"br label %{l}.cond"
          enter em (l + ".end")
        dropValue g em b (instr em $"load {llty g b}, ptr {sp}")
      // a placed ref: its cell is static, what it holds now is dropped
      | TCon("ref", [ x ]) when Map.containsKey v statics && heap g x ->
        let cell = instr em $"load ptr, ptr {valueSym v}"
        let vp = instr em $"getelementptr {{ i_W, {llty g x} }}, ptr {cell}, i32 0, i32 1"
        dropValue g em x (instr em $"load {llty g x}, ptr {vp}")
      | _ ->
        if heap g t then
          dropValue g em t (instr em $"load {llty g t}, ptr {valueSym v}")
    emit em "ret void"
    Buffer.push $"define private void @zsv.dropAll() {{\n{bodyOf em}}}\n\n" g.funcs
  // C entry points: main (an int result becomes the exit code) and [<Export>] wrappers
  if entry && Map.containsKey "main" fnTable then
    let main = Map.find "main" fnTable
    let rt = llty g main.ret
    let body =
      if tyName main.ret = "unit" then
        $"  call {{}} {sym g "main"}({{}} zeroinitializer)\n  ret i32 0"
      else if rt = "i32" then
        $"  %r = call i32 {sym g "main"}({{}} zeroinitializer)\n  ret i32 %r"
      else
        $"  %r = call {rt} {sym g "main"}({{}} zeroinitializer)\n  %c = trunc {rt} %r to i32\n  ret i32 %c"
    Buffer.push "define i32 @main(i32 %argc, ptr %argv) {\n  call void @zs_set_args(i32 %argc, ptr %argv)\n" g.funcs
    Buffer.push (initValues ()) g.funcs
    Buffer.push (String.replace body "  ret i32" "  call void @zsv.dropAll()\n  ret i32" + "\n}\n") g.funcs
  // a test build (zs test): main is the file's test entry ($tests, 0009), which lists the tests
  // or runs the one its argument names, so each test runs in its own process
  if entry && not (List.isEmpty tests) && not (Map.containsKey "main" fnTable) then
    let first = List.head tests
    let rt = llty g (Map.find first fnTable).ret
    Buffer.push "define i32 @main(i32 %argc, ptr %argv) {\n  call void @zs_set_args(i32 %argc, ptr %argv)\n" g.funcs
    Buffer.push (initValues ()) g.funcs
    Buffer.push $"  %r = call {rt} {sym g first}({{}} zeroinitializer)\n" g.funcs
    // the exit code: the result as it is where int is 32 bits (a chip)
    let code = if rt = "i32" then "" else $"  %c = trunc {rt} %r to i32\n"
    Buffer.push $"{code}  call void @zsv.dropAll()\n  ret i32 {(if rt = "i32" then "%r" else "%c")}\n}}\n" g.funcs
  for e in (if entry then exports else []) do
    let fd = Map.find e.fname fnTable
    let em = emitter ()
    let (rt, sret) = cRet g e.ret
    let cps = Buffer.empty
    if sret then
      // aligned as the struct is, as C's caller aligns it (8 would let LLVM store a word pair
      // where a Cortex-M faults)
      let (_, align, _) = cLayout g e.ret
      Buffer.push $"ptr sret({llty g e.ret}) align {align} %ret" cps
    let modes = cModes g (List.map snd fd.pars) sret
    let argOf (i: int) (pt: string * Ty) : Ty * string =
      let t = snd pt
      let n = $"%a{i}"
      match t with
      | TCon("unit", []) -> (t, "zeroinitializer")
      | _ when isHandle g t ->
        // C lends the handle: the object, with a reference of its own for the function
        Buffer.push $"ptr {n}" cps
        (t, instr em $"call ptr @zs_handle_get(ptr {n})")
      | _ ->
        match List.item i modes with
        | Scalar ->
          Buffer.push $"{cParam g t} {n}" cps
          (t, n)
        | Pieces ps ->
          let piece (k: int) (p: string) =
            let nk = $"{n}.{k}"
            Buffer.push (p + " " + nk) cps
            (p, nk)
          let named = List.mapi piece ps
          (t, fromPieces g em t named)
        | Memory ->
          Buffer.push $"{byval g t} {n}" cps
          (t, instr em $"load {llty g t}, ptr {n}")
    let args = List.mapi argOf fd.pars
    let argv = String.join ", " (List.map (fun (t, x) -> llty g t + " " + x) args)
    let r = instr em $"call {llty g fd.ret} {sym g e.fname}({argv})"
    match (e.ret, abiFor g e.ret true) with
    | (TCon("unit", []), _) -> emit em "ret void"
    | _ when isHandle g e.ret ->
      // the result's reference goes to a new handle, the caller's to release
      emit em $"ret ptr {handleOf g em e.ret r}"
    | (_, Memory) ->
      emit em $"store {llty g e.ret} {r}, ptr %ret"
      emit em "ret void"
    | (_, Scalar) -> emit em $"ret {llty g e.ret} {r}"
    | (_, Pieces [ p ]) ->
      let pieces = toPieces g em e.ret r [ p ]
      emit em $"ret {p} {snd (List.head pieces)}"
    | (_, Pieces ps) ->
      let insert (acc: string) (kpv: int * (string * string)) =
        let (k, (p, x)) = kpv
        instr em $"insertvalue {rt} {acc}, {p} {x}, {k}"
      let agg = List.fold insert "poison" (List.indexed (toPieces g em e.ret r ps))
      emit em $"ret {rt} {agg}"
    let cparams = String.join ", " (Array.toList (Buffer.toArray cps))
    Buffer.push $"define {rt} @{e.cname}({cparams}) {{\n{bodyOf em}}}\n\n" g.funcs
  // the header: [<CLayout>] structs, then prototypes
  let rec cName (t: Ty) : string =
    match t with
    | _ when isHandle g t -> "zs_handle"
    | TCon("ptr", [ p ]) -> (if isUnitTy p then "void" else cName p) + "*"
    | TCon("cptr", []) -> "void*"
    | TCon("fnptr", [ f ]) -> cFnPtr f ""
    | TCon("int", []) -> "intptr_t"
    | TCon(n, []) when Set.contains n signedInts -> $"int{String.sub n 1 (String.length n - 1)}_t"
    | TCon(n, []) when Set.contains n unsignedInts -> $"uint{String.sub n 1 (String.length n - 1)}_t"
    | TCon("usize", []) -> "size_t"
    | TCon("f64", []) -> "double"
    | TCon("f32", []) -> "float"
    | TCon("bool", []) -> "bool"
    | TCon("cstr", []) -> "const char*"
    | TCon("unit", []) -> "void"
    // a [<Bits>] record: its integer (0013)
    | TCon(n, []) when Option.isSome (bitsLayoutOf g t) -> $"uint{(Option.get (bitsLayoutOf g t)).width}_t"
    | TCon(n, []) -> String.replace n "." "_"
    | _ -> panic $"no C name for {showT g t}"
  // a C function pointer's declarator: R (*name)(A, B)
  and cFnPtr (f: Ty) (name: string) : string =
    let (ps0, r) = splitFun f
    let ps = List.map cName (List.filter (fun p -> not (isUnitTy p)) ps0)
    $"{cName r} (*{name})({(if List.isEmpty ps then "void" else String.join ", " ps)})"
  // a C declaration of `name` with this type (a function pointer's name goes inside it, and an
  // array's length after it: uint8_t data[16])
  let rec cDecl (t: Ty) (name: string) : string =
    match t with
    | TCon("fnptr", [ f ]) -> cFnPtr f name
    | TCon("fixed", [ el; TCon(n, []) ]) -> cDecl el $"{name}[{n}]"
    | _ -> $"{cName t} {name}"
  let header = Buffer.empty
  Buffer.push headerStart header
  // each struct after the ones its fields hold, so C knows them where it's used (by name
  // otherwise)
  let written = ref Set.empty
  let rec writeStruct (n: string) =
    if Set.contains n clayouts && not (Set.contains n written.Value) then
      written.Value <- Set.add n written.Value
      let shape =
        match Map.tryFind n types with
        | Some { def = RecordDef fs } -> Some("struct", fs)
        | Some { def = CUnionDef cs } -> Some("union", List.map (fun (c, ft) -> (Infer.Cx.afterLastDot c, ft)) cs)
        | _ -> None
      match shape with
      | Some(kind, fs) ->
        let rec held (t: Ty) =
          match t with
          | TCon(m, args) ->
            writeStruct m
            List.iter held args
          | TTuple ts -> List.iter held ts
          | _ -> ()
        for (_, ft) in fs do
          held ft
        let name = String.replace n "." "_"
        let fields = String.join "\n" (List.map (fun (f, ft) -> $"    {cDecl ft f};") fs)
        // the C compiler on the other side checks the size Z# lays the struct out with (0004)
        let check =
          match Types.Repr.layout g.v types (pointerBytes g) (TCon(n, [])) with
          | Some(size, _) -> $"_Static_assert(sizeof({name}) == {size}, \"{name} is {size} bytes in Z#\");\n"
          | None -> ""
        Buffer.push $"typedef {kind} {name} {{\n{fields}\n}} {name};\n{check}\n" header
      | None -> ()
  for n in Set.toList clayouts do
    writeStruct n
  for e in exports do
    let ps = List.mapi (fun i t -> cDecl t $"p{i}") e.pars
    Buffer.push $"{cName e.ret} {e.cname}({(if List.isEmpty ps then "void" else String.join ", " ps)});\n" header
  if opts.debugInfo then
    let cu = compileUnit g
    let flags = meta g "!{i32 7, !\"Dwarf Version\", i32 5}"
    let version = meta g "!{i32 2, !\"Debug Info Version\", i32 3}"
    Buffer.push $"!llvm.dbg.cu = !{{{cu}}}\n" g.md
    Buffer.push $"!llvm.module.flags = !{{{flags}, {version}}}\n" g.md
  // --coverage: a counter per line, the table of the lines (file and number), and a constructor
  // that hands them to the runtime, which writes them at exit (<program>.zscov)
  for (file, line) in opts.coverageSeeds do
    let key = $"{file}\t{line}"
    if not (Map.containsKey key g.cov.Value) then
      g.cov.Value <- Map.add key (Buffer.length g.covLines) g.cov.Value
      Buffer.push (file, line) g.covLines
  if Buffer.length g.covLines > 0 then
    let n = Buffer.length g.covLines
    let fileSyms = ref Map.empty
    let fileSym (file: string) =
      match Map.tryFind file fileSyms.Value with
      | Some s -> s
      | None ->
        let s = $"@\"zs.covf.{Map.count fileSyms.Value}\""
        topLine g $"{s} = private unnamed_addr constant [{String.length file + 1} x i8] c\"{encoded file}\\00\""
        fileSyms.Value <- Map.add file s fileSyms.Value
        s
    let entries = List.map (fun (file, line) -> $"{{ ptr, i32 }} {{ ptr {fileSym file}, i32 {line} }}") (Array.toList (Buffer.toArray g.covLines))
    topLine g $"@zs.cov.counts = internal global [{n} x i64] zeroinitializer"
    topLine g $"@zs.cov.table = private unnamed_addr constant [{n} x {{ ptr, i32 }}] [{String.join ", " entries}]"
    topLine g "@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @zs.cov.init, ptr null }]"
    Buffer.push $"define internal void @zs.cov.init() {{\n  call void @zs_coverage_register(ptr @zs.cov.table, ptr @zs.cov.counts, i64 {n})\n  ret void\n}}\n\n" g.funcs
  // the functions of other parts this one calls
  for f in Array.toList (Buffer.toArray g.referencedOrder) do
    if not (defined f) then
      match Map.tryFind f fnTable with
      | Some fd ->
        let ps = String.join ", " (List.map (fun (_, t) -> llty g t) fd.pars)
        Buffer.push $"declare {llty g fd.ret} {sym g f}({ps})\n" g.funcs
      | None -> ()
  match g.failure.Value with
  | Some(line, msg) -> Error(line, msg)
  | None ->
    let ir = String.concat [ joined top; "\n"; joined g.helpers; joined g.funcs; "\n"; joined g.md ]
    Ok(resolveWord opts ir, joined header)
