<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>zs</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- dotnet publish -r <rid>: precompiled, so a build doesn't wait for the JIT (~30% faster);
         self-contained, one composite image with FSharp.Core and the framework (~12% faster again) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite Condition="'$(SelfContained)' == 'true'">true</PublishReadyToRunComposite>
    <!-- a heap per core: the passes run on every core (non-concurrent: nothing to overlap with) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Syntax.fs" />
    <Compile Include="CImport.fs" />
    <Compile Include="Core.fs" />
    <Compile Include="Match.fs" />
    <Compile Include="Derive.fs" />
    <Compile Include="Typer.fs" />
    <Compile Include="Snapshot.fs" />
    <Compile Include="Mono.fs" />
    <Compile Include="Inline.fs" />
    <Compile Include="Simplify.fs" />
    <Compile Include="Decide.fs" />
    <Compile Include="Lift.fs" />
    <Compile Include="Rc.fs" />
    <Compile Include="Codegen.fs" />
    <Compile Include="Format.fs" />
    <Compile Include="Driver.fs" />
    <Compile Include="Rpc.fs" />
    <Compile Include="Lsp.fs" />
    <Compile Include="Mcp.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../runtime/rt.c" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../runtime/rt-embedded.c" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../runtime/boards/*.ld" LinkBase="boards" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../lib/**/*.zs" LinkBase="lib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
