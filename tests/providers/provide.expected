/// From "schema.sql": users (id, name, email, signed-up, score, active)
type Users = { id: int; name: string; email: option<string> = None; ``signed-up``: string; score: option<f64> = None; active: bool }

module Users =
  /// The table's name.
  let table = "users"
  /// Its columns, in order.
  let columns = [ "id"; "name"; "email"; "signed-up"; "score"; "active" ]

/// From "schema.sql": orders (id, user_id, total, note, payload)
type Orders = { id: int; user_id: int; total: f64; note: option<string> = None; payload: option<array<u8>> = None }

module Orders =
  /// The table's name.
  let table = "orders"
  /// Its columns, in order.
  let columns = [ "id"; "user_id"; "total"; "note"; "payload" ]
--- sql with named queries (one query's module)
module OrdersFor =
  /// The query, with ? where each parameter goes, in order.
  let sql = "SELECT o.id, o.total, u.name AS buyer, COUNT(*) AS n FROM orders o JOIN users u ON u.id = o.user_id WHERE o.user_id = ? AND o.total > ? GROUP BY o.id"
  /// :one, :many or :exec: what it gives.
  let kind = "many"
  /// Its parameters' names, in order.
  let parameters = [ "user"; "least" ]
  /// Its parameters, typed from the columns they meet.
  type Params = { user: int; least: f64 }
  /// A row it gives.
  type Row = { id: int; total: f64; buyer: string; n: int }

