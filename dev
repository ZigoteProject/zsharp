#!/usr/bin/env bash
# Runs a command inside the Z# dev container (built on first use), e.g. ./dev ./test.sh. The
# compiler in src/ is built by stage 0, the release pinned below, fetched on first use into
# build/stage0/ from $ZS_RELEASES: a directory of release archives (src/release.sh writes them
# to dist/), or a URL under which v<version>/<archive> is each release's.
set -euo pipefail
cd "$(dirname "$0")"
image=zsharp-dev
stage0=0.6.1
if [ "${1:-}" = "--rebuild" ] || ! podman image exists "$image"; then
  [ "${1:-}" = "--rebuild" ] && shift
  podman build -t "$image" -f .devcontainer/Containerfile .devcontainer
fi
name=zs-$stage0-linux-$(uname -m)
# each stage 0 archive's sha256: it runs with the repository mounted writable, so an archive
# from anywhere else is refused
declare -A sha256=([zs-0.6.1-linux-x86_64]=fdbc7d66b0ec54fef17d50ab231d846b4a7aa9cc1aac9c4e23df1d3dbe15dfa8)
if [ ! -x "build/stage0/$name/zs" ]; then
  sum=${sha256[$name]:-}
  [ -n "$sum" ] || { echo "no stage 0 for $(uname -m): only ${!sha256[*]} are pinned" >&2; exit 1; }
  from=${ZS_RELEASES:-dist}
  # a fresh clone has no dist/: stage 0 comes from this repository's GitHub releases
  [ -n "${ZS_RELEASES:-}" ] || [ -f "dist/$name.tar.gz" ] || from=https://github.com/ZigoteProject/zsharp/releases/download
  mkdir -p build/stage0
  archive=build/stage0/$name.tar.gz
  case $from in
    http://* | https://*) curl -fsSL -o "$archive" "$from/v$stage0/$name.tar.gz" ;;
    *) cp "$from/$name.tar.gz" "$archive" ;;
  esac || { echo "no stage 0: $name.tar.gz isn't in $from (set ZS_RELEASES)" >&2; exit 1; }
  echo "$sum  $archive" | sha256sum -c --quiet - || { rm -f "$archive"; echo "stage 0: $archive isn't the pinned $name" >&2; exit 1; }
  tar -xzf "$archive" -C build/stage0 && rm "$archive"
fi
tty=(); [ -t 0 ] && tty=(-it)
mkdir -p bin
exec podman run --rm "${tty[@]}" --userns=keep-id -v "$PWD":/work:z -v zsharp-home:/tmp/home:U \
  -e HOME=/tmp/home -e "ZS_STAGE0=/work/build/stage0/$name/zs" -w /work "$image" "${@:-bash}"
